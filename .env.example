# ============================================
# LUMEN Estudio — Variables de entorno
# Copiar a .env y rellenar valores reales
# ============================================

# --- Aplicación ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tudominio.com
NEXT_PUBLIC_APP_NAME="LUMEN Estudio"
PORT=3000
# Fetch interno server-side (src/services/gallery.ts): directo al proceso local.
# No usar la URL pública (el hairpin por el túnel muere con timeout).
# Solo cambiarlo si el puerto interno no es 3000.
# INTERNAL_APP_URL=http://localhost:3000

# --- Base de datos: PostgreSQL 16 en dev y prod (ver prisma/schema.prisma) ---
# DEV local (requiere `docker compose up -d postgres`):
#   DATABASE_URL="postgresql://lumen:change_me@localhost:5432/lumen_estudio"
#   npx prisma db push --skip-generate + npm run db:seed
# PROD / Homelab (coincide con docker-compose.prod.yml):
#   DATABASE_URL="postgresql://lumen:CHANGE_ME@db:5432/lumen_estudio?schema=public"
#   docker compose -f docker-compose.prod.yml exec app npx prisma db push --skip-generate + seed (sin migraciones versionadas aún)
DATABASE_URL="postgresql://lumen:CHANGE_ME@db:5432/lumen_estudio?schema=public"
DB_PASSWORD=CHANGE_ME

# --- Sesión (iron-session) ---
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_PASSWORD="REEMPLAZAR_CON_PASSWORD_DE_32_CHARS_MINIMO_BASE64"

# --- Storage ---
STORAGE_PROVIDER=local
UPLOADS_DIR=public/uploads

# --- Rate limiting ---
RATE_LIMIT_PROVIDER=memory

# --- Email (ver src/lib/email.ts) ---
# Sin SMTP_HOST ni RESEND_API_KEY la app NO envía correos: solo loguea en consola (modo dev).
# DEV: mailpit (SMTP_HOST=mailpit, SMTP_PORT=1025, ver en http://localhost:8025).
# PROD sin dominio (actual): Gmail SMTP con App Password
#   (myaccount.google.com/apppasswords; ver docs/HOMELAB.es.md § Email)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<tu-direccion-de-google>
#   SMTP_PASSWORD=<app-password-16-digitos>
#   EMAIL_FROM="LUMEN Estudio <<tu-direccion-de-google>>"
# PROD alternativa: Resend API (RESEND_API_KEY; sin dominio verificado solo
#   envía al dueño de la cuenta) — dejar SMTP_HOST vacío para forzar el path
#   Resend (src/lib/email.ts usa SMTP si existe, si no Resend).
# PROD con dominio: Postfix propio (SMTP_HOST=postfix, SMTP_PORT=25).
#   Requiere MAIL_DOMAIN + MAIL_HOSTNAME + DNS (SPF/DKIM/DMARC) + puerto 25.
# Opción 1: Resend (API)
RESEND_API_KEY=
# SMTP_HOST vacío = forzar Resend en vez de SMTP
SMTP_HOST=
SMTP_PORT=
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_SECURE=false
#
# Opción 2: SMTP (Nodemailer) — Gmail, Postfix propio, mailpit o relay externo
#   SMTP_HOST=smtp.gmail.com / postfix / mailpit
#   SMTP_PORT=587 / 25 / 1025
#
# Dominio de correo (solo Fase 2 Postfix + SPF/DKIM/DMARC; en Fase 1 puede quedar placeholder)
MAIL_DOMAIN=tudominio.com
MAIL_HOSTNAME=mail.tudominio.com
#
# Remitente Fase 1: onboarding@resend.dev (único que funciona sin verificar dominio).
# Con dominio verificado: "LUMEN Estudio <noreply@tudominio.com>" (debe coincidir con MAIL_DOMAIN para SPF).
EMAIL_FROM="LUMEN Estudio <onboarding@resend.dev>"
EMAIL_ADMIN=admin@tudominio.com

# --- Upstash (rate limit producción, opcional) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary (storage producción, opcional) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
